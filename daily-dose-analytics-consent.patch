+.analytics-consent-dialog{width:min(560px,calc(100% - 32px));padding:0;color:#f4ede2;background:#11100f;border:1px solid rgba(198,160,90,.55);border-radius:10px;box-shadow:0 24px 90px rgba(0,0,0,.72)}.analytics-consent-dialog::backdrop{background:rgba(0,0,0,.7)}.analytics-consent-dialog form{position:relative;padding:28px}.analytics-consent-dialog h2{margin:4px 0 12px;font-family:"Playfair Display",serif;font-size:32px}.analytics-consent-dialog p{color:#d8d0c4;line-height:1.65}.analytics-consent-dialog .analytics-consent-actions{margin:22px 0 16px}.analytics-consent-close{position:absolute;top:12px;right:14px;border:0;background:transparent;color:#f4ede2;font-size:28px;cursor:pointer}
